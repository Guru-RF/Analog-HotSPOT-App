{
  "name": "hotspot-app",
  "productName": "HotSpot",
  "version": "1.0.11",
  "description": "HotSpot — Desktop App for Mac, Windows and Linux (BLE feed viewer)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win nsis --x64 --arm64",
    "build:win:appx": "electron-builder --win appx --x64 --arm64"
  },
  "build": {
    "appId": "com.gururf.hotspot-app",
    "productName": "HotSpot",
    "copyright": "Copyright © 2026 RF.Guru",
    "afterAllArtifactBuild": "build/rename-mac-artifacts.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/tray-icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "Dielectricum (C4KY27CT2C)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "HotSpot connects to your hotspot over Bluetooth Low Energy to read the live feed and send DTMF / commands.",
        "NSBluetoothPeripheralUsageDescription": "HotSpot connects to your hotspot over Bluetooth Low Energy to read the live feed and send DTMF / commands."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${arch}.${ext}",
      "icon": "build/icon.png",
      "signtoolOptions": {
        "sign": "./build/win-sign.js"
      }
    },
    "appx": {
      "identityName": "RFGuru.SVXLink-HotSpot",
      "publisher": "CN=FBF35633-D0C5-410A-883E-75B3C38AB746",
      "publisherDisplayName": "RF Guru",
      "applicationId": "HotSpot",
      "displayName": "SVXLink-HotSpot",
      "backgroundColor": "#0b1220",
      "languages": [
        "en-US"
      ],
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "author": "RF.Guru",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.0.0"
  }
}
